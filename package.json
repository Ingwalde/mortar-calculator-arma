{
  "name": "mortar-tablet",
  "version": "0.8.0",
  "description": "Планшет мінометника — настільний застосунок для Arma Reforger",
  "author": "gdimas0603@gmail.com",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-places": "tsx scripts/check-places.ts",
    "dist:win": "electron-vite build && electron-builder --win",
    "smoke": "node scripts/smoke-packaged.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-forge": "^1.4.0",
    "nosleep.js": "^0.12.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true
  }
}
