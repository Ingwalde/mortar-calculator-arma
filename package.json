{
  "name": "mortar-tablet",
  "version": "1.1.3",
  "description": "Планшет мінометника — настільний застосунок для Arma Reforger",
  "author": "gdimas0603@gmail.com",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "licenses:collect": "node scripts/collect-third-party-licenses.mjs",
    "predev": "npm run licenses:collect",
    "prebuild": "npm run licenses:collect",
    "prebuild:web": "npm run licenses:collect",
    "predist:win": "npm run licenses:collect",
    "predist:setup": "npm run licenses:collect",
    "predist:mac": "npm run licenses:collect",
    "predist:linux": "npm run licenses:collect",
    "prepack": "npm run licenses:collect",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-places": "tsx scripts/check-places.ts",
    "dist:win": "electron-vite build && electron-builder --win && node scripts/build-setup-ui.mjs",
    "smoke": "node scripts/smoke-packaged.mjs",
    "build:web": "vite build --config vite.web.config.ts && tsx scripts/build-web-assets.ts",
    "preview:web": "vite preview --config vite.web.config.ts --outDir out/web --port 4173",
    "android:sync": "npm run build:web && node scripts/prune-apk-assets.mjs && node scripts/sync-android-version.mjs && cap sync android",
    "pack": "electron-vite build && electron-builder --win --dir",
    "check": "npm run typecheck && vitest run && npm run pack && npm run smoke && node scripts/check-setup-ui.mjs",
    "dist:setup": "electron-vite build && electron-builder --win nsis && node scripts/build-setup-ui.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "nosleep.js": "^0.12.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "node-forge": "^1.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@44.7.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  }
}
